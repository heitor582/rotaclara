@startuml
skinparam componentStyle rectangle
title RotaClara — Componentes da implementação
package "Cliente web" {
 [app.js] as Controller
 [views.js / formatters.js] as Views
 [api.js] as Client
 [charts.js / reporting.js] as Charts
 [Chart.js via CDN] as CDN
}
package "Servidor Python — rotaclara" {
 [http.py] as HTTP
 [application.py] as App
 [controllers/] as Controllers
 [endpoints.py] as Endpoints
 [dependencies.py] as Dependencies
 [services/ / security/] as Services
 [domain.py] as Domain
 [repositories/] as Repositories
 [database.py] as Transactions
 [exporters.py] as CSV
}
database SQLite as DB
Controller --> Views
Controller --> Charts
Charts --> CDN
Controller --> Client
Client --> HTTP : HTTP / JSON
HTTP --> App
App --> Endpoints : resolve rota
App --> Dependencies : monta dependências
Dependencies --> Controllers
App --> Controllers : executa endpoint
Controllers --> Services
App --> Transactions : unidade de trabalho
Controllers --> CSV
Services --> Domain
Services --> Repositories
Repositories --> DB : SQL parametrizado
Transactions --> DB : commit / rollback
@enduml
